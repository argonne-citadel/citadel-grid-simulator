Clear
! IEEE 8500-Node Test Feeder — ZT-CARD wrapper
!
! Loads the Siemens PowerGym 8500-Node model (fetched via Dockerfile sparse
! clone) and adds a rooftop PV portfolio for ZT-CARD multi-zone experiments.
!
! The 8500-Node feeder is a ~11 MW peak load, 12.47 kV distribution circuit
! with ~4900 buses, ~3700 line segments, ~1200 service transformers, 3 voltage
! regulators, and 4 capacitor banks.  BFS zone partitioning with NUM_RTU_ZONES=5
! creates 5 control zones for the authorization experiment.
!
! DER portfolio: 15 rooftop PV clusters (3 per zone × 5 zones), ~3.25 MW total
! (~30% penetration on 11 MW peak). Each "PV system" represents an aggregation
! of 10-30 residential rooftop installations on a single service lateral.
! All host buses are verified primary nodes owning the phase they're
! assigned to (checked via dss.Bus.Nodes()), 7.2 kV.
!
! Phase siting (2026-10): all 20 PVSystems (this cluster portfolio plus the
! 5 zone-fleet units below) originally sat on phase-1-ONLY laterals, ~3 MW
! concentrated on a single phase. With voltage bases fixed (see below), night
! hours matched stock (0.926-1.050 pu) but midday (PV at ~3 MW on one phase)
! read 0.826-1.103 pu with 2,711 nodes under 0.95 pu and phase-B regulators
! pinned at tap 16 -- confirmed concentration, not a sizing problem (scaling
! all PV to 1/3 gave 0.918-1.055 with no siting change). 15 of the 20 were
! re-sited to the nearest upstream bus on the same feeder path that actually
! owns the target phase (dss.Bus.Nodes()), keeping every name/kVA/Pmpp
! unchanged and primary kV=7.2. Final split ~1050/1250/1450 kW across
! phases 1/2/3 (not perfectly even: an exact 1250/1250/1250 LPT-balanced
! split left hours 12-14 at 1.0581-1.0583 pu, ~0.0003 over the 1.058 Range B
! ceiling, from feeder-head regulator response to the phase-1/2 PV offset;
! shifting ~200 kW from phase 1 to phase 3 brought every hour 0-23 inside
! ANSI C84.1 Range B, 0.917-1.058 pu). Original bus.phase -> new bus.phase
! (hop = BFS hops walked upstream to find a bus owning the target phase;
! unlisted units are unchanged, 0 hops):
!   pv_up_z1a  l2766729.1  -> m1047316.2   hop=2
!   pv_up_z2a  l3727712.1  -> m1047490.3   hop=8
!   pv_up_z4a  m3016088.1  -> m1027055.2   hop=28
!   pv_up_z0b  l3217056.1  -> m1209791.3   hop=6
!   pv_up_z1b  l2823545.1  -> m1108505.3   hop=17
!   pv_up_z3b  l3235247.1  -> m1026960.2   hop=5
!   pv_up_z4b  193-48013.1 -> m1069284.3   hop=8
!   pv_up_z0c  p829797.1   -> m1108484.3   hop=1
!   pv_up_z1c  l2879054.1  -> m1089143.2   hop=9
!   pv_up_z3c  l3122822.1  -> m1026701.2   hop=7
!   pv_up_zf1  l3217056.1  -> m1209791.2   hop=6
!   pv_up_zf2  p829797.1   -> m1108484.3   hop=1
!   pv_up_zf3  l2823545.1  -> m1108505.3   hop=17
!   pv_up_zf4  l3251854.1  -> m1069564.2   hop=6
!   pv_up_zf5  l3235247.1  -> m1026960.3   hop=5
!
! Usage: GRID_MODEL=/usr/app/examples/Run_IEEE8500_ZTCARD.dss

! Load the base IEEE 8500 model (all component files are in ieee8500/ subdir)
Redirect ieee8500/Master.dss

! ============================================================================
! PV/Temperature curves (shared by all PV systems, same as IEEE37Bus_PV.dss)
! ============================================================================
New XYCurve.MyPvsT npts=4 xarray=[0 25 75 100] yarray=[1.2 1.0 0.8 0.6]
New XYCurve.MyEff npts=4 xarray=[.1 .2 .4 1.0] yarray=[.86 .9 .93 .97]
New Loadshape.MyIrrad npts=24 interval=1 mult=[0 0 0 0 0 0 0.1 .2 .3 .5 .8 .9 1.0 1.0 .99 .9 .7 .4 .1 0 0 0 0 0]
New Tshape.MyTemp npts=24 interval=1 temp=[25 25 25 25 25 25 25 25 35 40 45 50 60 60 55 40 35 30 25 25 25 25 25 25]

! ============================================================================
! Zone 0 — near substation, east side (BFS depth 26-98)
!   p827522:  deep lateral, dist=98, ~30 residential rooftops (unchanged)
!   l3217056: near substation, dist=26, ~25 rooftops (re-sited to
!             m1209791.3, see siting table above)
!   p829797:  deep lateral alternate, dist=97, ~10 rooftops (re-sited to
!             m1108484.3, see siting table above)
! ============================================================================
New Transformer.pv_up_z0a phases=1 Xhl=5.75
~ wdg=1 bus=p827522.1 kV=7.2 kVA=350
~ wdg=2 bus=trafo_pv_z0a kV=0.24 kVA=350
New PVSystem.PV_0A phases=1 bus1=trafo_pv_z0a kV=0.24 kVA=350 irrad=0.98 Pmpp=300 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z0b phases=1 Xhl=5.75
~ wdg=1 bus=m1209791.3 kV=7.2 kVA=300
~ wdg=2 bus=trafo_pv_z0b kV=0.24 kVA=300
New PVSystem.PV_0B phases=1 bus1=trafo_pv_z0b kV=0.24 kVA=300 irrad=0.98 Pmpp=250 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z0c phases=1 Xhl=5.75
~ wdg=1 bus=m1108484.3 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_z0c kV=0.24 kVA=125
New PVSystem.PV_0C phases=1 bus1=trafo_pv_z0c kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! ============================================================================
! Zone 1 — mid-feeder, south side (BFS depth 105-146)
!   l2766729: deep lateral, dist=146 (re-sited to m1047316.2, see siting
!             table above)
!   l2823545: far south, dist=124 (re-sited to m1108505.3, see siting table
!             above)
!   l2879054: mid-feeder, dist=105 (re-sited to m1089143.2, see siting
!             table above)
! ============================================================================
New Transformer.pv_up_z1a phases=1 Xhl=5.75
~ wdg=1 bus=m1047316.2 kV=7.2 kVA=350
~ wdg=2 bus=trafo_pv_z1a kV=0.24 kVA=350
New PVSystem.PV_1A phases=1 bus1=trafo_pv_z1a kV=0.24 kVA=350 irrad=0.98 Pmpp=300 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z1b phases=1 Xhl=5.75
~ wdg=1 bus=m1108505.3 kV=7.2 kVA=300
~ wdg=2 bus=trafo_pv_z1b kV=0.24 kVA=300
New PVSystem.PV_1B phases=1 bus1=trafo_pv_z1b kV=0.24 kVA=300 irrad=0.98 Pmpp=250 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z1c phases=1 Xhl=5.75
~ wdg=1 bus=m1089143.2 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_z1c kV=0.24 kVA=125
New PVSystem.PV_1C phases=1 bus1=trafo_pv_z1c kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! ============================================================================
! Zone 2 — mid-feeder, west-central (BFS depth 165-202)
!   l3727712: deep lateral, dist=202 (re-sited to m1047490.3, see siting
!             table above)
!   l3104135: mid-range, dist=174 (unchanged)
!   l3251854: mid-feeder, dist=165 (unchanged; a second array, zf4, was
!             later co-located at m1069564.2, see siting table above)
! ============================================================================
New Transformer.pv_up_z2a phases=1 Xhl=5.75
~ wdg=1 bus=m1047490.3 kV=7.2 kVA=350
~ wdg=2 bus=trafo_pv_z2a kV=0.24 kVA=350
New PVSystem.PV_2A phases=1 bus1=trafo_pv_z2a kV=0.24 kVA=350 irrad=0.98 Pmpp=300 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z2b phases=1 Xhl=5.75
~ wdg=1 bus=l3104135.1 kV=7.2 kVA=300
~ wdg=2 bus=trafo_pv_z2b kV=0.24 kVA=300
New PVSystem.PV_2B phases=1 bus1=trafo_pv_z2b kV=0.24 kVA=300 irrad=0.98 Pmpp=250 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z2c phases=1 Xhl=5.75
~ wdg=1 bus=l3251854.1 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_z2c kV=0.24 kVA=125
New PVSystem.PV_2C phases=1 bus1=trafo_pv_z2c kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

