! Zone 3 — deep feeder, south-west (BFS depth 233-234)
!   n1138596: deep lateral, dist=234 (unchanged)
!   l3235247: deep lateral alternate, dist=233 (re-sited to m1026960.2, see
!             siting table above; a second array, zf5, was later co-located
!             at m1026960.3)
!   l3122822: deep lateral alternate, dist=233 (re-sited to m1026701.2, see
!             siting table above)
! ============================================================================
New Transformer.pv_up_z3a phases=1 Xhl=5.75
~ wdg=1 bus=n1138596.1 kV=7.2 kVA=350
~ wdg=2 bus=trafo_pv_z3a kV=0.24 kVA=350
New PVSystem.PV_3A phases=1 bus1=trafo_pv_z3a kV=0.24 kVA=350 irrad=0.98 Pmpp=300 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z3b phases=1 Xhl=5.75
~ wdg=1 bus=m1026960.2 kV=7.2 kVA=300
~ wdg=2 bus=trafo_pv_z3b kV=0.24 kVA=300
New PVSystem.PV_3B phases=1 bus1=trafo_pv_z3b kV=0.24 kVA=300 irrad=0.98 Pmpp=250 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

