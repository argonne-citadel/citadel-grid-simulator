!   m3016088:  deep lateral, dist=274 (re-sited to m1027055.2, see siting
!              table above)
!   193-48013: mid-range, dist=257 (re-sited to m1069284.3, see siting
!              table above)
!   l3065696:  mid-feeder, dist=248 (unchanged)
! ============================================================================
New Transformer.pv_up_z4a phases=1 Xhl=5.75
~ wdg=1 bus=m1027055.2 kV=7.2 kVA=350
~ wdg=2 bus=trafo_pv_z4a kV=0.24 kVA=350
New PVSystem.PV_4A phases=1 bus1=trafo_pv_z4a kV=0.24 kVA=350 irrad=0.98 Pmpp=300 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z4b phases=1 Xhl=5.75
~ wdg=1 bus=m1069284.3 kV=7.2 kVA=300
~ wdg=2 bus=trafo_pv_z4b kV=0.24 kVA=300
New PVSystem.PV_4B phases=1 bus1=trafo_pv_z4b kV=0.24 kVA=300 irrad=0.98 Pmpp=250 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

New Transformer.pv_up_z4c phases=1 Xhl=5.75
~ wdg=1 bus=l3065696.1 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_z4c kV=0.24 kVA=125
New PVSystem.PV_4C phases=1 bus1=trafo_pv_z4c kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp


! ── Zone-fleet sites (5, added 2026-09-15 for ztcard-stack #1270) ──────────
! Every BFS zone must own >=4 DERs so a coordinated same-zone operation is
! expressible in it. Both S7 der_aggregation and benign coordinated dispatch
! write a same-zone fleet, and a zone that cannot field one silently removes
! itself from the experiment. Enforced by _assert_every_zone_has_a_der_fleet,
! which failed all five ieee_8500 cells of corpus 21818 with the measured
! distribution {0:2, 1:4, 2:2, 3:4, 4:3}.
!
! The zNx naming above does NOT track the BFS partition: pv_up_z0a sits in
! zone 1, z1b in zone 2, z3b in zone 4. Those names record intent at authoring
! time while the partitioner decides the truth — the same drift that left
! IEEE-123 with a zone owning no DER at all. These five are named zf* and their
! zones are stated from the measured map, not inferred from a suffix.
!
! Each is co-located on a bus that already hosts a PV in the short zone, which
! guarantees zone membership without needing the pandapower-index-to-OpenDSS
! name mapping. A second array on one distribution transformer is ordinary.
! 125 kVA, the smallest existing tier, to limit the power-flow change.

! zf1: zone 0, co-located with der-pv-0b
New Transformer.pv_up_zf1 phases=1 Xhl=5.75
~ wdg=1 bus=m1209791.2 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_zf1 kV=0.24 kVA=125
New PVSystem.PV_ZF1 phases=1 bus1=trafo_pv_zf1 kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! zf2: zone 0, co-located with der-pv-0c
New Transformer.pv_up_zf2 phases=1 Xhl=5.75
~ wdg=1 bus=m1108484.3 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_zf2 kV=0.24 kVA=125
New PVSystem.PV_ZF2 phases=1 bus1=trafo_pv_zf2 kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! zf3: zone 2, co-located with der-pv-1b
New Transformer.pv_up_zf3 phases=1 Xhl=5.75
~ wdg=1 bus=m1108505.3 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_zf3 kV=0.24 kVA=125
New PVSystem.PV_ZF3 phases=1 bus1=trafo_pv_zf3 kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! zf4: zone 2, co-located with der-pv-2c
New Transformer.pv_up_zf4 phases=1 Xhl=5.75
~ wdg=1 bus=m1069564.2 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_zf4 kV=0.24 kVA=125
New PVSystem.PV_ZF4 phases=1 bus1=trafo_pv_zf4 kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! zf5: zone 4, co-located with der-pv-3b
New Transformer.pv_up_zf5 phases=1 Xhl=5.75
~ wdg=1 bus=m1026960.3 kV=7.2 kVA=125
~ wdg=2 bus=trafo_pv_zf5 kV=0.24 kVA=125
New PVSystem.PV_ZF5 phases=1 bus1=trafo_pv_zf5 kV=0.24 kVA=125 irrad=0.98 Pmpp=100 temperature=25 PF=1 effcurve=Myeff P-TCurve=MyPvsT Daily=MyIrrad TDaily=MyTemp

! ============================================================================
! Solve configuration
! ============================================================================
! Voltage bases are line-to-line. 0.208 is the stock feeder's own base for its
! ~4,500 120/240 V split-phase service-transformer secondaries (ieee8500/
! Master.dss uses it already) -- without it those nodes get snapped to the
! nearest base of 0.24 and a healthy node reads ~0.87 pu. 0.415692 is for the
! PV step-up secondaries added above: they are rated 0.24 kV line-to-NEUTRAL
! on a single-phase winding (LL-equivalent 0.24*sqrt(3) = 0.415692 kV), same
! reasoning as Run_IEEE123_ZTCARD.dss.
Set VoltageBases = "115, 12.47, 0.48, 0.415692, 0.208"
CalcVoltageBases
Set mode=daily
Set stepsize=1h
Set number=1
Solve
